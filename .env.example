# Скопируйте этот файл в .env и укажите свои значения.

# --- Сервер приложения ---
NODE_ENV=development
# Порт приложения. С TLS-сертификатом: 3443 в разработке, 443 — в боевом режиме
# (диаграмма развёртывания). Без сертификата приложение работает по HTTP на этом порту.
PORT=3443
# Порт HTTP-сервера, который перенаправляет на HTTPS (боевой режим — 80).
HTTP_PORT=3000
# Пути к TLS-ключу и сертификату (создаются командой npm run cert). Если оба заданы — HTTPS.
TLS_KEY_PATH=certs/key.pem
TLS_CERT_PATH=certs/cert.pem

# --- База данных PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitness_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Сессии ---
# Длинная случайная строка, например результат: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=замените_на_случайную_строку
SESSION_MAX_AGE_HOURS=8

# --- Безопасность ---
BCRYPT_ROUNDS=12

# --- Резервное копирование (используется на этапе ФТ-15) ---
BACKUP_DIR=./backups
# Каталог bin PostgreSQL с pg_dump и pg_restore, например C:\Program Files\PostgreSQL\17\bin
PG_BIN_DIR=
# Расписание автоматического резервного копирования (cron), по умолчанию — ежедневно в 03:00.
BACKUP_SCHEDULE=0 3 * * *
# Ключ шифрования копий AES-256-GCM — 64 шестнадцатеричных символа. Создать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Без ключа копии не создаются. Потерянный ключ = недоступные копии: храните его отдельно.
BACKUP_KEY=

# --- Первый администратор (скрипт npm run admin:create) ---
# npm run db:seed создаёт администратора admin / admin123, если логин admin ещё свободен.
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
