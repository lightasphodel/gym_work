# Скопируйте этот файл в .env и укажите свои значения.

# --- Сервер приложения ---
NODE_ENV=development
PORT=3000
# Пути к TLS-ключу и сертификату. Если оба файла заданы, сервер запускается по HTTPS.
# Для боевого режима по диаграмме развёртывания: PORT=443.
TLS_KEY_PATH=
TLS_CERT_PATH=

# --- База данных PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitness_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Сессии ---
# Длинная случайная строка, например результат: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=замените_на_случайную_строку
SESSION_MAX_AGE_HOURS=8

# --- Безопасность ---
BCRYPT_ROUNDS=12

# --- Резервное копирование (используется на этапе ФТ-15) ---
BACKUP_DIR=./backups
# Каталог bin PostgreSQL с pg_dump и pg_restore, например C:\Program Files\PostgreSQL\17\bin
PG_BIN_DIR=

# --- Первый администратор (скрипт npm run admin:create) ---
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
