<%#
  Главное меню. Пункты зависят от роли из сессии (currentUser);
  активный пункт отмечается aria-current="page" по адресу страницы (currentPath).
  Остальные страницы из CLAUDE.md добавляются в меню по мере их появления (этап 11).
-%>
<%
  const user = locals.currentUser ?? null;
  const menus = {
    GUEST: [
      { href: '/login', text: 'Вход' },
      { href: '/register', text: 'Регистрация' },
    ],
    USER: [
      { href: '/home', text: 'Главная' },
      { href: '/programs', text: 'Программа' },
      { href: '/workouts/new', text: 'Тренировка' },
      { href: '/profile', text: 'Профиль' },
      { href: '/exercises', text: 'Упражнения' },
      { href: '/tools/1rm', text: '1ПМ' },
    ],
    ADMIN: [
      { href: '/admin', text: 'Панель администратора' },
      { href: '/admin/users', text: 'Пользователи' },
      { href: '/admin/exercises', text: 'Упражнения' },
      { href: '/admin/templates', text: 'Шаблоны' },
    ],
  };
  const items = (user && menus[user.role]) || menus.GUEST;
  // Активный пункт — самый длинный адрес, с которого начинается адрес страницы
  // (/exercises/5 → «Упражнения», /admin/users → только «Пользователи»).
  const path = locals.currentPath ?? '';
  const current = items
    .filter((item) => path === item.href || path.startsWith(item.href + '/'))
    .reduce((best, item) => (!best || item.href.length > best.href.length ? item : best), null);
-%>
      <nav class="nav" id="site-nav" aria-label="Основная навигация">
<% for (const item of items) { -%>
        <a class="nav__link" href="<%= item.href %>"<%- item === current ? ' aria-current="page"' : '' %>><%= item.text %></a>
<% } -%>
<% if (user) { -%>
        <span class="nav__user"><%= user.login %></span>
        <button type="button" class="nav__link" id="logout-button">Выйти</button>
<% } -%>
      </nav>
