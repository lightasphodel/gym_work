<%#
  Анкета тренировочного профиля (ФТ-03).
  form — значения полей, errors — сообщения проверки по полям (сервер),
  saved — профиль сохранён, isNew — профиль ещё не создан.
-%>
<%
  const invalid = (name) => (errors[name] ? ' aria-invalid="true"' : '');
  const describedBy = (name, hint) => {
    const ids = [hint, errors[name] ? name + '-error' : ''].filter(Boolean).join(' ');
    return ids ? ` aria-describedby="${ids}"` : '';
  };
  const hasErrors = Object.keys(errors).length > 0;
-%>
      <h1 class="page__title">Тренировочный профиль</h1>
      <p class="page__intro"><%= isNew
        ? 'Заполните анкету: по ней составляется программа тренировок и рассчитываются стартовые рабочие веса.'
        : 'Изменения профиля учитываются при составлении следующей программы.' %></p>
      <div class="page__content">
        <section class="card form-card" aria-labelledby="profile-title">
          <form class="form" method="post" action="/profile" novalidate>
            <h2 class="form__title" id="profile-title">Анкета</h2>
<% if (locals.required) { -%>
            <div class="alert alert--error" role="alert">Чтобы составить программу, заполните анкету полностью</div>
<% } -%>
<% if (saved) { -%>
            <div class="alert alert--success" role="status">Профиль сохранён</div>
<% } -%>
<% if (hasErrors) { -%>
            <div class="alert alert--error" role="alert">Проверьте поля, отмеченные ниже</div>
<% } -%>

            <div class="field">
              <label for="goal">Цель тренировок</label>
              <select id="goal" name="goal" required<%- invalid('goal') %><%- describedBy('goal') %>>
                <option value=""<%- form.goal ? '' : ' selected' %>>Выберите цель</option>
<% for (const [value, name] of Object.entries(goalNames)) { -%>
                <option value="<%= value %>"<%- form.goal === value ? ' selected' : '' %>><%= name %></option>
<% } -%>
              </select>
<% if (errors.goal) { -%>
              <span class="field__error" id="goal-error"><%= errors.goal %></span>
<% } -%>
            </div>

            <div class="field">
              <label for="level">Уровень подготовки</label>
              <select id="level" name="level" required<%- invalid('level') %><%- describedBy('level') %>>
                <option value=""<%- form.level ? '' : ' selected' %>>Выберите уровень</option>
<% for (const [value, name] of Object.entries(levelNames)) { -%>
                <option value="<%= value %>"<%- form.level === value ? ' selected' : '' %>><%= name %></option>
<% } -%>
              </select>
<% if (errors.level) { -%>
              <span class="field__error" id="level-error"><%= errors.level %></span>
<% } -%>
            </div>

            <div class="field">
              <label for="workouts-per-week">Тренировок в неделю</label>
              <input type="number" id="workouts-per-week" name="workoutsPerWeek" min="2" max="6" step="1" required
                     value="<%= form.workoutsPerWeek %>"<%- invalid('workoutsPerWeek') %><%- describedBy('workoutsPerWeek', 'workouts-hint') %>>
              <span class="field__hint" id="workouts-hint">От 2 до 6</span>
<% if (errors.workoutsPerWeek) { -%>
              <span class="field__error" id="workoutsPerWeek-error"><%= errors.workoutsPerWeek %></span>
<% } -%>
            </div>

            <div class="field" role="group" aria-labelledby="equipment-label"<%- describedBy('equipment', 'equipment-hint') %>>
              <span class="field__label" id="equipment-label">Доступный инвентарь</span>
              <div class="chips">
<% equipmentList.forEach((item, i) => { -%>
                <input type="checkbox" class="chip-input visually-hidden" id="equipment-<%= i %>" name="equipment"
                       value="<%= item %>"<%- form.equipment.includes(item) ? ' checked' : '' %><%- invalid('equipment') %>>
                <label class="chip" for="equipment-<%= i %>"><%= item %></label>
<% }) -%>
              </div>
              <span class="field__hint" id="equipment-hint">Упражнения программы подбираются только под отмеченный инвентарь</span>
<% if (errors.equipment) { -%>
              <span class="field__error" id="equipment-error"><%= errors.equipment %></span>
<% } -%>
            </div>

            <div class="field">
              <label for="body-weight">Масса тела, кг</label>
              <input type="number" id="body-weight" name="bodyWeight" min="30" max="300" step="0.01" required
                     inputmode="decimal" value="<%= form.bodyWeight %>"<%- invalid('bodyWeight') %><%- describedBy('bodyWeight', 'body-weight-hint') %>>
              <span class="field__hint" id="body-weight-hint">От 30 до 300 кг — нужна для расчёта стартовых весов</span>
<% if (errors.bodyWeight) { -%>
              <span class="field__error" id="bodyWeight-error"><%= errors.bodyWeight %></span>
<% } -%>
            </div>

            <div class="button-row">
              <button type="submit" class="button button--primary">Сохранить</button>
              <a class="button button--ghost" href="/home">На главную</a>
            </div>
          </form>
        </section>
      </div>
