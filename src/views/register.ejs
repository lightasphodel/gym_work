      <section class="hero">
        <h1 class="hero__title">Начните вести тренировки</h1>
        <p class="hero__lead">После регистрации заполните профиль: цель, уровень подготовки и число тренировок в неделю.</p>
      </section>

      <section class="card form-card" aria-labelledby="register-title">
        <form id="register-form" class="form" novalidate>
          <h2 class="form__title" id="register-title">Регистрация</h2>
          <div class="alert alert--error" id="form-error" role="alert" hidden></div>

          <div class="field">
            <label for="login">Логин</label>
            <input type="text" id="login" name="login" autocomplete="username" required
                   minlength="3" maxlength="50" aria-describedby="login-hint">
            <span class="field__hint" id="login-hint">От 3 до 50 символов: латинские буквы, цифры, «_», «.», «-»</span>
          </div>
          <div class="field">
            <label for="email">Электронная почта</label>
            <input type="email" id="email" name="email" autocomplete="email" required maxlength="100">
          </div>
          <div class="field">
            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" autocomplete="new-password" required
                   minlength="8" aria-describedby="password-hint">
            <span class="field__hint" id="password-hint">Не менее 8 символов, хотя бы одна буква и одна цифра</span>
          </div>
          <div class="field">
            <label for="password-confirm">Повторите пароль</label>
            <input type="password" id="password-confirm" name="passwordConfirm" autocomplete="new-password" required>
          </div>

          <button type="submit" class="button button--primary">Зарегистрироваться</button>
          <p class="form-footer">Уже зарегистрированы? <a href="/login">Войти</a></p>
        </form>
      </section>
